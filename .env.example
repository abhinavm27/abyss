# Local endpoint created by the private SSH tunnel to the GN100.
HERMES_BASE_URL=http://127.0.0.1:8642/v1

# Retrieve at runtime from the GN100. Never commit the value.
HERMES_API_KEY=

# Model currently served locally on the GN100.
HERMES_MODEL=nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4

# Optional read-only SQLite catalog produced by the hospital knowledge engine.
# ABYSS_KNOWLEDGE_DB=/absolute/path/to/knowledge-engine/abyss.db

# Application state is separate from the read-only knowledge catalog.
# ABYSS_DB=/absolute/path/to/vela-state.db

# Tailscale/MagicDNS SSH target used by scripts/tunnel-hermes.sh.
GN100_SSH_HOST=gn100-75f8
GN100_SSH_USER=acer01
HERMES_API_PORT=8642
HERMES_DASHBOARD_PORT=18791

# Discord link notifications and inbound @Vela bot. Keep all real values in a
# gitignored runtime env file. The webhook sends generic links only.
ABYSS_MESSAGING_CHANNEL=discord
ABYSS_MESSAGING_MODE=sandbox
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_USERNAME=vela
DISCORD_DESTINATION_LABEL=discord:eevee
ABYSS_DISCORD_ALLOWLIST=discord:eevee
ABYSS_PUBLIC_APP_URL=http://100.102.193.84:4173
DISCORD_BOT_TOKEN=
DISCORD_BOT_SECRET=
DISCORD_ALLOWED_CHANNEL_IDS=
DISCORD_ALLOWED_GUILD_IDS=
DISCORD_USER_MAP=
ABYSS_DISCORD_DEFAULT_USER_ID=
ABYSS_API_BASE_URL=http://127.0.0.1:8011

# Optional sandbox/live Twilio adapter. Live mode still requires exact consent.
ABYSS_SMS_ALLOWLIST=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
