# The public preview is an interactive synthetic journey and needs no credentials.
VITE_DEMO_MODE=true

# Enable only when the FastAPI service is running and the browser has an authenticated session.
VITE_LIVE_MODE=false
# HTTPS origin used when a browser blocks microphone capture on an HTTP URL.
VITE_SECURE_APP_URL=

# Optional when the API is not served from the same origin.
VITE_API_URL=http://127.0.0.1:8010
