# Copy to backend/.env and fill in your own key. Never commit backend/.env —
# it's gitignored, but double-check before any `git add -A`.

# Hermes runs inside the NemoClaw sandbox on the GN100. Use the private tunnel.
HERMES_BASE_URL=http://127.0.0.1:8642/v1
HERMES_API_KEY=
HERMES_MODEL=nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4

# NVIDIA Speech NIMs. Parakeet receives complete VAD-delimited turns; Magpie
# streams raw mono PCM back to the browser. 22.05 kHz is supported by the
# installed Magpie NIM and is announced in the WebSocket ready frame.
NVIDIA_ASR_URL=http://127.0.0.1:9001
NVIDIA_TTS_URL=http://127.0.0.1:9002
NVIDIA_SPEECH_LANGUAGE=en-US
NVIDIA_TTS_VOICE=Magpie-Multilingual.EN-US.Mia.Calm
NVIDIA_ASR_SAMPLE_RATE=16000
NVIDIA_TTS_SAMPLE_RATE=22050
NVIDIA_SPEECH_TIMEOUT=60

# Optional — defaults to backend/abyss.db if unset.
# ABYSS_DB=

# Optional separate read-only hospital catalog. Published rates are exposed as
# evidence only; this data does not establish insurance network status.
# ABYSS_KNOWLEDGE_DB=/absolute/path/to/knowledge-engine/abyss.db

# Consented, link-only Discord notifications.
ABYSS_MESSAGING_CHANNEL=discord
ABYSS_MESSAGING_MODE=sandbox
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_USERNAME=vela
DISCORD_DESTINATION_LABEL=discord:eevee
ABYSS_DISCORD_ALLOWLIST=discord:eevee
ABYSS_PUBLIC_APP_URL=http://100.102.193.84:4173

# Inbound @Vela Discord bot. User/channel mapping is enforced by the API.
DISCORD_BOT_TOKEN=
DISCORD_BOT_SECRET=
DISCORD_ALLOWED_CHANNEL_IDS=
DISCORD_ALLOWED_GUILD_IDS=
DISCORD_USER_MAP=
ABYSS_DISCORD_DEFAULT_USER_ID=
ABYSS_API_BASE_URL=http://127.0.0.1:8011

# Optional Twilio channel. Keep destinations allowlisted and credentials out of Git.
ABYSS_SMS_ALLOWLIST=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
