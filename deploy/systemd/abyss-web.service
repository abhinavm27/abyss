[Unit]
Description=ABYSS Vite preview frontend
After=network-online.target abyss-api.service
Wants=network-online.target abyss-api.service

[Service]
Type=simple
User=acer01
Group=acer01
WorkingDirectory=/home/acer01/abyss-demo/apps/web
EnvironmentFile=/etc/abyss/abyss.env
Environment=NODE_ENV=production
Environment=NPM_CONFIG_CACHE=/tmp/abyss-npm-cache
ExecStartPre=/usr/bin/npm run build
ExecStart=/usr/bin/npm run preview -- --host 0.0.0.0 --port 4173 --strictPort
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGINT
UMask=0027

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/acer01/abyss-demo/apps/web/dist /home/acer01/abyss-demo/apps/web/node_modules/.vite-temp
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
