[Unit]
Description=Check ABYSS API, frontend, state, and knowledge catalog
After=abyss-api.service abyss-web.service

[Service]
Type=oneshot
User=acer01
Group=acer01
WorkingDirectory=/home/acer01/abyss-demo
EnvironmentFile=/etc/abyss/abyss.env
ExecStart=/home/acer01/abyss-demo/scripts/gn100-health.sh --quiet
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
