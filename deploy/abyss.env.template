# Installed as /etc/abyss/abyss.env by scripts/gn100-install-services.sh.
# This repository copy contains no credentials. Keep the installed file mode 0600.

# Application state: users, sessions, journeys, appointments, and receipts.
ABYSS_DB=/home/acer01/abyss-demo/data/abyss-state.db

# Read-only Seattle hospital catalog maintained by the original ingestion tree.
ABYSS_KNOWLEDGE_DB=/home/acer01/abyss/services/api/abyss.db

# Authenticated Hermes gateway. Retrieve the key on GN100; never commit it.
HERMES_BASE_URL=http://127.0.0.1:8642/v1
HERMES_API_KEY=
HERMES_MODEL=nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4

# NVIDIA speech services running on GN100.
NVIDIA_ASR_URL=http://127.0.0.1:9001
NVIDIA_TTS_URL=http://127.0.0.1:9002
NVIDIA_SPEECH_LANGUAGE=en-US
NVIDIA_TTS_VOICE=Magpie-Multilingual.EN-US.Mia.Calm
NVIDIA_ASR_SAMPLE_RATE=16000
NVIDIA_TTS_SAMPLE_RATE=22050
NVIDIA_SPEECH_TIMEOUT=60

# Notifications stay sandboxed until an operator intentionally selects live.
ABYSS_MESSAGING_MODE=sandbox
ABYSS_PUBLIC_APP_URL=http://100.102.193.84:4173
ABYSS_DISCORD_ALLOWLIST=discord:eevee
DISCORD_DESTINATION_LABEL=discord:eevee
DISCORD_WEBHOOK_URL=
ABYSS_SMS_ALLOWLIST=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Browser origins allowed to call the API directly.
ABYSS_CORS_ORIGINS=http://100.102.193.84:4173,http://localhost:4173,http://localhost:4174

# Vite embeds these public endpoints at build time. Update the host if the
# GN100 Tailscale address changes, then restart abyss-web.
VITE_API_URL=http://100.102.193.84:8011
VITE_WS_URL=ws://100.102.193.84:8011/ws
VITE_LIVE_MODE=true
VITE_DEMO_MODE=false
# Set to the HTTPS/tunneled frontend URL when microphone capture is required.
VITE_SECURE_APP_URL=

# Used only by the supervised health check.
ABYSS_API_HEALTH_URL=http://127.0.0.1:8011/api/health
ABYSS_WEB_HEALTH_URL=http://127.0.0.1:4173/
